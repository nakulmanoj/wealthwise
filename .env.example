# ─────────────────────────────────────────────────────────────
# .env.example — copy this to .env and fill in your real values
# The .env file is gitignored and should NEVER be committed.
# ─────────────────────────────────────────────────────────────

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/wealthwise
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JWT — generate a strong 256-bit Base64-encoded secret, e.g.:
#   openssl rand -base64 32 | tr -d '\n' | base64
JWT_SECRET=your_base64_encoded_jwt_secret_here
JWT_EXPIRATION=86400000

# Finnhub Market Data API — get your key at https://finnhub.io
FINNHUB_TOKEN=your_finnhub_api_token_here
